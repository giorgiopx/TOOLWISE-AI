---
import { formatDate, isPublishable, type Article } from '../lib/articles';

interface Props { article: Article }
const { article } = Astro.props;
const { title, description, category, publishDate } = article.data;
---
<article class="card">
  <p class="card-meta">
    <span class="pill">{category}</span>
    {!isPublishable(article) && <span class="pill pill-draft">Draft</span>}
  </p>
  <h3><a href={`/articles/${article.id}/`}>{title}</a></h3>
  <p class="card-desc">{description}</p>
  <time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time>
</article>
