---
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
---
<Base title="Affiliate disclosure" description="How Toolwise AI may earn money from links on the site.">
  <Prose title="Affiliate disclosure" lede="How this site may earn money, and how that is kept separate from our recommendations.">
    <p>
      Some pages on Toolwise AI may contain affiliate links. If you click one and then buy a product or subscription,
      we may earn a commission. This costs you nothing extra.
    </p>
    <p>
      Articles that contain affiliate links say so near the top of the page. We only link to products we believe are
      relevant to the topic, and affiliate relationships do not influence which tools we cover, how we evaluate them
      or how we rank them.
    </p>
    <p>
      We may also display advertising in the future. If we do, ads will be clearly separated from editorial content,
      and this page and our <a href="/privacy/">privacy policy</a> will be updated.
    </p>
    <p>Questions about this policy? <a href="/contact/">Get in touch</a>.</p>
  </Prose>
</Base>
