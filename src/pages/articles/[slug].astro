---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getArticles, formatDate, isPublishable, type Article } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const { title, description, category, publishDate, updatedDate, author, affiliate } = article.data;
const { Content } = await render(article);
---
<Base title={title} description={description} noindex={!isPublishable(article)}>
  <section class="page-head">
    <div class="wrap narrow">
      <p class="eyebrow">{category}</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="article-meta">
        <span>By {author}</span>
        <time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time>
        {updatedDate && <span>Updated {formatDate(updatedDate)}</span>}
      </div>
    </div>
  </section>
  <div class="wrap narrow prose">
    {!isPublishable(article) && (
      <div class="notice notice-draft"><strong>Draft preview.</strong> This article is not reviewed and is not included in production builds.</div>
    )}
    {affiliate && (
      <div class="notice">This article may contain affiliate links. If you buy through them we may earn a commission at no extra cost to you. <a href="/affiliate-disclosure/">Learn more</a>.</div>
    )}
    <Content />
    <p><a href="/articles/">← All articles</a></p>
  </div>
</Base>
