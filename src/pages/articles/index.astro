---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../lib/articles';

const articles = await getArticles();
---
<Base title="Articles" description="Guides, workflows and comparisons for using AI tools in freelance and small-team work.">
  <section class="page-head">
    <div class="wrap">
      <h1>Articles</h1>
      <p class="lede">Guides, workflows and comparisons for using AI tools in real client work.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      {articles.length > 0 ? (
        <div class="cards">{articles.map((a) => <ArticleCard article={a} />)}</div>
      ) : (
        <div class="empty">
          <strong>Our first articles are being reviewed.</strong> Every guide is fact-checked before publication —
          read our <a href="/editorial-policy/">editorial policy</a> to see how.
        </div>
      )}
    </div>
  </section>
</Base>
