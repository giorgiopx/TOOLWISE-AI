---
const { title = 'Toolwise AI — Practical AI tools. Honest comparisons. Better work.', description = 'Practical AI tool reviews, comparisons and workflows for freelancers and solo entrepreneurs.' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const pageUrl = canonical;
const ogType = Astro.props.ogType ?? 'website';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#101321" />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  {pageUrl && <meta property="og:url" content={pageUrl} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>{title}</title>
  <!-- Add the exact AdSense script from your own AdSense account here only after site approval. Never paste account passwords or private API keys into website code. -->
</head>
<body>
  <div class="ambient ambient-one" aria-hidden="true"></div><div class="ambient ambient-two" aria-hidden="true"></div>
  <header class="site-header"><a class="brand" href="/" aria-label="Toolwise AI home"><span class="brand-mark">t<span>.</span></span><span class="brand-word">toolwise<span>ai</span></span></a><nav aria-label="Main navigation"><a href="/articles/">Explore</a><a href="/about/">Our approach</a><a href="/editorial-policy/">Editorial standards</a></nav><a class="header-cta" href="/articles/">Find your next tool <span>↗</span></a></header>
  <main><slot /></main>
  <footer class="site-footer"><div class="footer-top"><a class="brand" href="/"><span class="brand-mark">t<span>.</span></span><span class="brand-word">toolwise<span>ai</span></span></a><p>Less noise. Better tools. Work that moves.</p></div><div class="footer-bottom"><small>© {new Date().getFullYear()} Toolwise AI · Independent editorial publication.</small><div class="footer-links"><a href="/about/">About</a><a href="/editorial-policy/">Editorial policy</a><a href="/affiliate-disclosure/">Affiliate disclosure</a><a href="/privacy/">Privacy</a><a href="/contact/">Contact</a></div></div></footer>
  <script is:inline>
    const observer = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), {threshold: 0.12});
    document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));
  </script>
</body>
</html>
<style is:global>
:root{font-family:'Manrope',ui-sans-serif,system-ui,sans-serif;color:#f4f4f7;background:#101321;font-synthesis:none;text-rendering:optimizeLegibility;--ink:#f4f4f7;--muted:#a2a7bd;--line:rgba(255,255,255,.13);--lime:#d6ff70;--violet:#a69bff;--panel:#191d30;--soft:#252a41}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;line-height:1.7;overflow-x:hidden;background:radial-gradient(ellipse at 12% 2%,rgba(101,83,181,.14),transparent 28%),#101321}a{color:inherit;text-decoration:none}a:hover{color:var(--lime)}button,input{font:inherit}.ambient{position:absolute;pointer-events:none;z-index:-1;filter:blur(1px);opacity:.55}.ambient-one{width:380px;height:380px;top:320px;right:-170px;background:radial-gradient(circle at 35% 30%,rgba(214,255,112,.16),rgba(166,155,255,.05) 55%,transparent 70%);border-radius:46% 54% 62% 38% / 38% 48% 52% 62%;animation:floaty 14s ease-in-out infinite}.ambient-two{width:300px;height:300px;top:1250px;left:-170px;background:radial-gradient(circle,rgba(166,155,255,.12),transparent 70%);border-radius:50%;animation:floaty 18s ease-in-out infinite reverse}.site-header{max-width:1240px;margin:auto;padding:22px 28px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:11px;font-size:1.05rem;font-weight:800;letter-spacing:-.055em}.brand-mark{display:grid;place-items:center;width:37px;height:37px;border-radius:13px;background:var(--lime);color:#101321;font-size:1.2rem;font-weight:900;transform:rotate(-6deg)}.brand-mark span{color:#6553b5}.brand-word{letter-spacing:-.06em}.brand-word span{color:var(--lime)}.site-header nav{display:flex;gap:28px;font-size:.85rem;font-weight:650;color:#c1c4d3}.site-header nav a:hover{color:var(--lime)}.header-cta{font-size:.82rem;font-weight:800;border:1px solid var(--line);padding:10px 14px;border-radius:99px}.header-cta span{color:var(--lime);padding-left:6px}main{min-height:70vh}.wrap{max-width:1240px;margin:auto;padding:76px 28px}.eyebrow{display:inline-flex;align-items:center;gap:10px;text-transform:uppercase;letter-spacing:.16em;font-family:'DM Mono',monospace;font-size:.7rem;font-weight:500;color:var(--lime)}.eyebrow:before{content:'';display:inline-block;width:22px;height:1px;background:var(--lime)}.hero{max-width:1240px;margin:auto;padding:86px 28px 74px;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:46px;min-height:580px}.hero h1{font-size:clamp(3.2rem,7.5vw,6.8rem);line-height:.97;letter-spacing:-.085em;margin:24px 0 24px;max-width:760px}.hero h1 .outline{color:transparent;-webkit-text-stroke:1.4px var(--lime)}.hero-copy{max-width:590px;font-size:1.08rem;color:#b5b8ca;line-height:1.8}.hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:18px;margin-top:30px}.button{display:inline-flex;align-items:center;gap:14px;background:var(--lime);color:#101321!important;padding:14px 20px;border-radius:99px;font-weight:850;font-size:.9rem;box-shadow:0 0 0 0 rgba(214,255,112,.15);transition:transform .25s,box-shadow .25s}.button:hover{transform:translateY(-3px);box-shadow:0 10px 35px rgba(214,255,112,.12)}.text-link{font-weight:750;font-size:.9rem;color:#f1f1f7}.hero-art{min-height:400px;position:relative;display:grid;place-items:center;isolation:isolate}.orbit{position:absolute;border:1px solid rgba(214,255,112,.28);border-radius:50%;transform:rotate(-25deg)}.orbit-a{width:370px;height:180px;animation:orbit 22s linear infinite}.orbit-b{width:310px;height:310px;border-color:rgba(166,155,255,.32);animation:orbit 27s linear infinite reverse}.orbit-c{width:430px;height:270px;border-color:rgba(255,255,255,.12);transform:rotate(52deg)}.orb-core{width:190px;height:190px;border-radius:39% 61% 54% 46% / 44% 38% 62% 56%;background:linear-gradient(140deg,#d6ff70 2%,#a9e6b7 38%,#a69bff 78%,#6254ad 100%);box-shadow:inset -22px -28px 50px rgba(16,19,33,.23),0 0 80px rgba(166,155,255,.22);animation:morph 10s ease-in-out infinite;transform:rotate(-18deg)}.orb-core:after{content:'';position:absolute;inset:18px 36px 40px 22px;border-radius:50%;border:1px solid rgba(255,255,255,.55);transform:rotate(28deg)}.float-card{position:absolute;background:rgba(25,29,48,.88);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.17);border-radius:17px;padding:14px 16px;box-shadow:0 20px 50px rgba(0,0,0,.2);font-size:.75rem}.float-card strong{display:block;font-size:.88rem;margin-bottom:3px}.float-card span{color:var(--muted)}.float-one{top:48px;left:5px;transform:rotate(-7deg)}.float-two{right:0;top:130px;transform:rotate(6deg)}.float-three{bottom:40px;left:35px;transform:rotate(4deg)}.tiny-dot{width:7px;height:7px;display:inline-block;border-radius:50%;background:var(--lime);margin-right:7px}.signal-row{border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;justify-content:center;gap:44px;flex-wrap:wrap;padding:18px 24px;color:#9fa4bb;font-family:'DM Mono',monospace;text-transform:uppercase;font-size:.68rem;letter-spacing:.12em}.section-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:28px}.section-head h2{font-size:clamp(2rem,4vw,3.1rem);line-height:1.05;letter-spacing:-.065em;margin:13px 0 0}.section-head p{max-width:420px;color:var(--muted);margin:0}.article-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}.article-card{position:relative;overflow:hidden;border:1px solid var(--line);border-radius:23px;padding:25px;background:linear-gradient(145deg,rgba(34,39,62,.88),rgba(21,24,40,.88));display:flex;flex-direction:column;min-height:290px;transition:transform .25s,border-color .25s,background .25s}.article-card:hover{transform:translateY(-5px);border-color:rgba(214,255,112,.5);background:linear-gradient(145deg,rgba(40,46,72,.98),rgba(21,24,40,.98))}.card-top{display:flex;justify-content:space-between;align-items:center;gap:10px}.category{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--lime);font-weight:500;text-transform:uppercase;letter-spacing:.1em}.card-number{font-family:'DM Mono',monospace;color:#717790;font-size:.72rem}.article-card h3{font-size:1.32rem;line-height:1.28;letter-spacing:-.045em;margin:23px 0 11px}.article-card p{color:#aeb3c8;font-size:.88rem;line-height:1.7}.article-card .read{margin-top:auto;padding-top:20px;font-size:.83rem;font-weight:800}.article-card .read span{color:var(--lime);margin-left:7px}.card-glow{position:absolute;width:130px;height:130px;right:-58px;bottom:-70px;border-radius:50%;background:rgba(166,155,255,.13);filter:blur(3px);pointer-events:none}.feature-band{margin:10px auto 70px;max-width:1184px;padding:42px;border:1px solid var(--line);border-radius:28px;background:linear-gradient(115deg,rgba(214,255,112,.08),rgba(166,155,255,.1));display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.feature-band h2{font-size:clamp(1.8rem,3.7vw,3rem);line-height:1.08;letter-spacing:-.06em;margin:15px 0}.feature-band p{color:#b4b8cb}.feature-points{display:grid;gap:15px}.feature-point{display:flex;gap:13px;align-items:flex-start;color:#c8cbda;font-size:.9rem}.feature-point i{font-style:normal;color:var(--lime);font-size:1.1rem}.page-intro{padding:72px 28px 38px;max-width:1240px;margin:auto}.page-intro h1{font-size:clamp(2.7rem,6vw,5rem);letter-spacing:-.08em;line-height:1.02;margin:18px 0}.page-intro p{max-width:700px;color:#b5b8ca;font-size:1.05rem}.filter-bar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:24px 0 28px}.search-input{min-width:250px;flex:1;background:#191d30;border:1px solid var(--line);color:var(--ink);border-radius:12px;padding:13px 15px;outline:none}.search-input:focus{border-color:var(--lime)}.filter-count{font-family:'DM Mono',monospace;color:var(--muted);font-size:.72rem}.prose{max-width:820px;margin:auto;padding:50px 28px 100px}.prose h1{font-size:clamp(2.5rem,5.8vw,4.7rem);line-height:1.03;letter-spacing:-.075em;margin:22px 0}.prose h2{font-size:1.75rem;line-height:1.2;letter-spacing:-.05em;margin-top:2.3em}.prose h3{letter-spacing:-.03em;margin-top:1.8em}.prose p,.prose li{color:#c0c4d4}.prose a{text-decoration:underline;text-decoration-color:var(--lime);text-underline-offset:4px}.prose ul,.prose ol{padding-left:1.3rem}.prose li{padding:.22rem 0}.prose blockquote{border-left:2px solid var(--lime);padding:5px 0 5px 20px;margin:28px 0;color:#e3e5ee}.prose .meta{color:#9da3ba;font-family:'DM Mono',monospace;font-size:.72rem;text-transform:uppercase;letter-spacing:.08em}.article-hero{padding-bottom:24px}.article-hero .category{font-size:.72rem}.article-hero .dek{font-size:1.15rem;color:#b8bdd0;max-width:720px}.article-callout{border:1px solid rgba(214,255,112,.25);background:rgba(214,255,112,.055);border-radius:16px;padding:20px 22px;margin:30px 0;color:#dce0ed}.article-callout strong{color:var(--lime)}.notice{border:1px solid rgba(214,255,112,.25);background:rgba(214,255,112,.06);border-radius:14px;padding:18px;margin:24px 0;color:#dce0ed}.site-footer{max-width:1240px;margin:auto;padding:32px 28px 28px;border-top:1px solid var(--line);color:#969bb1}.footer-top,.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap}.footer-top p{font-size:.86rem}.footer-bottom{margin-top:26px;padding-top:20px;border-top:1px solid var(--line)}.footer-bottom small{font-size:.73rem}.footer-links{display:flex;flex-wrap:wrap;gap:17px;font-size:.76rem}.reveal{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}.reveal.is-visible{opacity:1;transform:translateY(0)}.article-end{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-top:32px;margin-top:48px;border-top:1px solid var(--line)}.article-end a{color:var(--lime);font-weight:800}.back-link{display:inline-block;color:#c0c4d4;font-size:.84rem;margin-bottom:25px}.skip-link{position:absolute;left:-9999px}.skip-link:focus{left:20px;top:20px;z-index:100;background:var(--lime);color:#101321;padding:10px}
@keyframes floaty{0%,100%{transform:translate3d(0,0,0) rotate(0)}50%{transform:translate3d(12px,-20px,0) rotate(12deg)}}@keyframes orbit{to{transform:rotate(335deg)}}@keyframes morph{0%,100%{border-radius:39% 61% 54% 46% / 44% 38% 62% 56%;transform:rotate(-18deg)}50%{border-radius:56% 44% 38% 62% / 51% 60% 40% 49%;transform:rotate(8deg)}}@media(max-width:900px){.hero{grid-template-columns:1fr;gap:10px;padding-top:60px}.hero-art{min-height:340px}.article-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.feature-band{margin-left:20px;margin-right:20px;padding:30px;grid-template-columns:1fr}.signal-row{gap:18px}}@media(max-width:620px){.site-header{padding:18px 20px;flex-wrap:wrap}.site-header nav{order:3;width:100%;gap:18px;font-size:.78rem}.header-cta{margin-left:auto;font-size:.72rem}.hero{padding:58px 20px 46px}.hero h1{font-size:clamp(3rem,15vw,4.5rem)}.hero-art{min-height:300px;transform:scale(.85);margin:-10px -24px}.orbit-a{width:300px}.orbit-b{width:260px;height:260px}.orbit-c{width:330px}.orb-core{width:150px;height:150px}.float-one{left:0;top:22px}.float-two{right:0;top:100px}.float-three{bottom:12px;left:5px}.wrap{padding:48px 20px}.section-head{align-items:flex-start;flex-direction:column}.article-grid{grid-template-columns:1fr}.article-card{min-height:240px}.page-intro{padding:55px 20px 25px}.prose{padding:35px 20px 75px}.feature-band{padding:24px;margin:8px 20px 50px}.footer-top,.footer-bottom{align-items:flex-start;flex-direction:column}.site-footer{padding:28px 20px}.signal-row{font-size:.58rem;letter-spacing:.07em}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;scroll-behavior:auto!important;transition:none!important}.reveal{opacity:1;transform:none}}
</style>
